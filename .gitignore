# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment / credentials — NEVER commit
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# Pipeline logs (contain run data, not committed)
logs/runs/*.json
logs/zeitgeist_cache.json
logs/audit/*.json

# Security scan outputs
logs/trivy-results.json
logs/trivy-*.json
logs/bandit-results.json
logs/promptfoo-results.json
logs/framing-results.json

# Node.js
agent_sandbox/node_modules/
agent_sandbox/dist/
truthlens/node_modules/

# OPA cache
*.rego.cache
.cache/trivy/

# Docker build artifacts
docker/*.digest

# Dagger
.dagger/

# Binary documents and reference papers — store externally, not in git
*.pdf
*.docx
*.doc
*.docm
*.xlsx
*.xls
*.xlsm
*.pptx
*.ppt
*.odt
*.ods
*.odp

# Archives
*.zip
*.tar.gz
*.tgz
*.tar.bz2
*.7z
*.rar

# Media and image blobs (project-level; tauri icons are scoped under scp/)
# Use scp/tolsv3/artifact_lens_project/.gitignore for image test fixtures

# OS junk
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
